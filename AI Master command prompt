{
    id = c03
    prerequisite = c02
    titleKey = #LOC_Lodeworks_Campaign_Mun_Title
    mainQuest = True
    deadlineSeconds = 0
    OBJECTIVE
    {
        id = munOreReturn
        kind = deliver
        endpoint = ksc-receiver
        cargoKind = batch
        originBody = Mun
        gradeBand = any
        amount = 100
        eligibility = minedAnyTime
